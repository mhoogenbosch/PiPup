<?xml version="1.0" encoding="utf-8"?>
<!-- 1.1.0: the settings screen. Plain widgets: every one is DPAD-focusable, EditText opens
     the TV keyboard on OK. Sizes follow the status screen (18sp labels, 10-foot UI). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ic_launcher_background"
        android:fillViewport="true">
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="64dp"
            android:paddingEnd="64dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                android:textSize="22sp"
                android:textStyle="bold"/>

        <TextView
                android:id="@+id/textStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="15sp"
                android:textColor="@color/ok"/>

        <Switch
                android:id="@+id/switchHttp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/settings_http_switch"
                android:textSize="18sp"
                android:focusable="true"/>
        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_http_why"
                android:textSize="14sp"
                android:textColor="@color/neutral"/>

        <Switch
                android:id="@+id/switchMqtt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/settings_mqtt_switch"
                android:textSize="18sp"
                android:focusable="true"/>
        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_mqtt_why"
                android:textSize="14sp"
                android:textColor="@color/neutral"/>

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:baselineAligned="false">
            <EditText
                    android:id="@+id/editHost"
                    android:layout_width="0dp"
                    android:layout_weight="3"
                    android:layout_height="wrap_content"
                    android:hint="@string/settings_mqtt_host"
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:imeOptions="actionNext"/>
            <EditText
                    android:id="@+id/editPort"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:hint="@string/settings_mqtt_port"
                    android:inputType="number"
                    android:singleLine="true"
                    android:imeOptions="actionNext"/>
        </LinearLayout>

        <CheckBox
                android:id="@+id/checkTls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_mqtt_tls"
                android:textSize="16sp"
                android:focusable="true"/>

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">
            <EditText
                    android:id="@+id/editUsername"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="@string/settings_mqtt_username"
                    android:inputType="text"
                    android:singleLine="true"
                    android:imeOptions="actionNext"/>
            <EditText
                    android:id="@+id/editPassword"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:hint="@string/settings_mqtt_password"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:imeOptions="actionNext"/>
        </LinearLayout>

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">
            <EditText
                    android:id="@+id/editPrefix"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="@string/settings_mqtt_prefix"
                    android:inputType="text"
                    android:singleLine="true"
                    android:imeOptions="actionNext"/>
            <EditText
                    android:id="@+id/editName"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:hint="@string/settings_mqtt_name"
                    android:inputType="text"
                    android:singleLine="true"
                    android:imeOptions="actionDone"/>
        </LinearLayout>

        <TextView
                android:id="@+id/textTopic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:textColor="@color/neutral"/>

        <Button
                android:id="@+id/buttonSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_gravity="center_horizontal"
                android:text="@string/settings_save"
                android:focusable="true"/>

        <TextView
                android:id="@+id/textMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_horizontal"
                android:textSize="15sp"
                android:textColor="@color/warning"/>
    </LinearLayout>
</ScrollView>
